# Copy this file to keystore.properties and replace every placeholder.
# keystore.properties is ignored by Git; never commit it or the keystore.
# Paths may be absolute or relative to the repository root.
storeFile=/absolute/path/to/sms-forwarder-release.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=sms-forwarder-release
keyPassword=REPLACE_WITH_KEY_PASSWORD
